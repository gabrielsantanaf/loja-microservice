@model VShop.Web.Models.ProductViewModel

<div class="page-heading">
    <span class="icon-badge text-danger bg-danger-subtle"><i class="fas fa-trash-alt"></i></span>
    <h3 class="mb-0">Delete Product</h3>
</div>

<div class="card">
    <div class="card-body p-4">
        <h5 class="text-danger mb-4">Are you sure you want to delete this?</h5>
        <div class="row g-4">
            <div class="col-md-4">
                <img src="~/images/@Model.ImageURL" class="product-thumb" />
            </div>
            <div class="col-md-8">
                <dl class="row mb-0">
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Name)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Name)
                    </dd>
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.CategoryName)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.CategoryName)
                    </dd>
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Description)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Description)
                    </dd>
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Price)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Price)
                    </dd>
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Stock)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Stock)
                    </dd>
                </dl>
            </div>
        </div>

        <form asp-action="DeleteProduct" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <input type="submit" value="Delete" class="btn btn-danger" />
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
