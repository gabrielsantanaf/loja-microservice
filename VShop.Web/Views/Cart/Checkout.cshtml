@model CartViewModel

@if (Model is not null && Model.CartItems.Count() > 0)
{
    <form method="post">
        <input asp-for="CartHeader.UserId" hidden />
        <input asp-for="CartHeader.Id" hidden />
        <input asp-for="CartHeader.CouponCode" hidden />
        <input asp-for="CartHeader.Discount" hidden />
        <input asp-for="CartHeader.TotalAmount" hidden />
        <input asp-for="CartItems" hidden />

        <div class="page-heading">
            <span class="icon-badge"><i class="fa fa-credit-card"></i></span>
            <h2 class="mb-0">Billing Address</h2>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card h-100">
                    <div class="card-header bg-white">
                        <i class="fa fa-user"></i> Contact &amp; Payment
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="control-label">First Name</label>
                                <input asp-for="CartHeader.FirstName" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="control-label">Last Name</label>
                                <input asp-for="CartHeader.LastName" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="control-label"><i class="fa fa-envelope"></i> E-mail</label>
                                <input asp-for="CartHeader.Email" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="control-label"><i class="fa fa-phone"></i> Telephone</label>
                                <input asp-for="CartHeader.Telephone" class="form-control" />
                            </div>
                            <div class="col-12"><hr /></div>
                            <div class="col-md-6">
                                <label class="control-label"><i class="fa fa-credit-card"></i> Card Number</label>
                                <input asp-for="CartHeader.CardNumber" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="control-label">Name on Card</label>
                                <input asp-for="CartHeader.NameOnCard" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="control-label">CVV</label>
                                <input asp-for="CartHeader.CVV" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="control-label">Expire Date</label>
                                <input asp-for="CartHeader.ExpireMonthYear" placeholder="MMYY" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card h-100">
                    <div class="card-header bg-white">
                        <i class="fa fa-shopping-basket"></i> Your Basket
                    </div>
                    <div class="card-body">
                        <div class="d-none d-lg-block">
                            <div class="row text-muted fw-semibold">
                                <div class="col-6">
                                    Product Details
                                </div>
                                <div class="col-3">
                                    Price
                                </div>
                                <div class="col-3">
                                    Quantity
                                </div>
                            </div>
                        </div>

                        <hr />

                        @foreach (var item in Model.CartItems)
                        {
                            <div class="row">
                                <div class="col-6">
                                    <span>@item.Product.Name</span>
                                </div>
                                <div class="col-3">
                                    <span>@string.Format("{0:c}", item.Product.Price)</span>
                                </div>
                                <div class="col-3">
                                    <span>
                                        @item.Quantity
                                    </span>
                                </div>

                            </div>
                            <hr />
                        }
                        <div class="row">
                            <div class="col-12 text-primary fw-bold fs-5">
                                Total Amount: @string.Format("{0:c}", Model.CartHeader.TotalAmount)<br />
                                @if (Model.CartHeader.Discount > 0)
                                {
                                    <span class="text-danger fs-6">
                                        Discount : @string.Format("{0:P}", Model.CartHeader.Discount / 100)
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary form-control fw-bold">
                            <span>Continue to Checkout</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
}
