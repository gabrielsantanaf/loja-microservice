@model IEnumerable<VShop.Web.Models.ProductViewModel>
<link rel="stylesheet" href="/css/product.css" asp-append-version="true" />

<div class="page-heading">
    <span class="icon-badge"><i class="fas fa-store"></i></span>
    <h2 class="mb-0">Our Products</h2>
</div>

<form>
    <div class="container-fluid px-0">
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    <a href="/Home/ProductDetails/@product.Id">
                        <div class="card h-100">
                            <img class="card-img-top product-thumb" src="/images/escolar/@product.ImageURL">
                            <div class="card-body">
                                <h5 class="card-title mb-2">
                                    @product.Name
                                </h5>
                                <p class="card-text text-primary fw-bold mb-0">
                                    @product.Price.ToString("C")
                                </p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</form>
