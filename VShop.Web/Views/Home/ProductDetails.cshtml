@model VShop.Web.Models.ProductViewModel

<form method="post">
    <input asp-for="Id" hidden />
    <div class="page-heading">
        <span class="icon-badge"><i class="fas fa-box-open"></i></span>
        <h3 class="mb-0">Detalhes do Produto</h3>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-5">
                    <img class="product-thumb-lg" src="/images/escolar/@Model.ImageURL">
                </div>
                <div class="col-md-7 d-flex flex-column">
                    <h3>@Model.Name</h3>
                    <p class="text-muted mb-3">@Model.Description</p>
                    <p class="mb-4">
                        <span class="fs-3 fw-bold text-primary">@Model.Price.ToString("C")</span>
                        <span class="badge bg-secondary-subtle text-secondary-emphasis ms-2">@Model.Stock in stock</span>
                    </p>

                    <div class="row g-3 align-items-end mb-4">
                        <div class="col-6 col-md-4">
                            <label asp-for="Quantity" class="control-label">Quantidade</label>
                            <input asp-for="Quantity" class="form-control" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row g-2 mt-auto">
                        <div class="col-6 col-md-4">
                            <a asp-action="Index" class="btn btn-outline-secondary w-100">Back to List</a>
                        </div>
                        <div class="col-6 col-md-4">
                            <button type="submit" class="btn btn-primary w-100">Add to Cart</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
